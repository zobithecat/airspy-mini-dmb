# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Vendored upstream (huge; rebuild via patches)
eti-stuff/

# Build artefacts (FFmpeg fork, etc.)
build/
local/

# Captured RF / ETI data — binary payloads excluded by default; JSON
# metadata sidecars (data/**/*.json) are allowed so the artefact bundle
# stays self-describing.  The two reference captures cited by the paper
# are tracked via git-lfs (see .gitattributes) — they're whitelisted
# below so .gitignore doesn't shadow them.
#
# Note: do NOT exclude directories themselves (e.g. `data/captures/`) —
# that would block git from descending into them and the `!` negations
# below would never fire.
data/scan/
*.eti
*.iq
*.bin
*.ts

# Reference captures — large but reproducibility-critical; stored in
# Git LFS (see .gitattributes).
!data/captures/k8b_100pct.eti
!data/captures/k8b_rust.iq
!data/captures/k8b_strong.iq
!data/captures/k8b_v2.iq
!data/captures/k8b_v2.eti
!data/captures/k8b_v3.iq
!data/captures/k8b_v3.eti
!data/long_captures/k8b_5min.eti

# Generated ensemble JSON dumps (from eti-cmdline -J) — these are produced
# automatically next to each capture and aren't reproducibility metadata.
ensemble-ch-*.json

# Local settings
.claude/settings.local.json
