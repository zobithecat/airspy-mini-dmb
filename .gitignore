*.egg-info/
build/
dist/
.venv/
venv/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Vendored upstream (huge; rebuild via patches)
eti-stuff/

# Build artefacts (FFmpeg fork, etc.)
build/
local/

# Captured RF / ETI data — binary payloads excluded; JSON metadata
# sidecars (data/**/*.json) are allowed so the artefact bundle stays
# self-describing.  Note: do NOT exclude directories themselves
# (e.g. `data/captures/`) — that would block git from descending into
# them and the `!*.json` negation below would never fire.
data/scan/
*.eti
*.iq
*.bin
*.ts

# Generated ensemble JSON dumps (from eti-cmdline -J) — these are produced
# automatically next to each capture and aren't reproducibility metadata.
ensemble-ch-*.json

# Local settings
.claude/settings.local.json
